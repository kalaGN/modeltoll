{
  "name": "laya-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "description": "Laya 独立前端，开发服务器或 Nginx 提供页面并同源代理 API",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run && node --test tests/unit/*.test.mjs tests/contract/*.test.mjs",
    "test:server": "node --test tests/integration/*.test.mjs",
    "test:nginx": "node tests/integration/nginx-check.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.5.1",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "tailwindcss": "^4.3.3"
  }
}
