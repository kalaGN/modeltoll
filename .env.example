# Copy to a private env file and supply your own passwords. Empty passwords
# deliberately make Compose refuse to start. Do not commit the private file.
MYSQL_DATABASE=laya_platform
MYSQL_USER=laya_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# App binds only to 127.0.0.1. Use 8012 if port 8000 is already occupied.
APP_PORT=8000
# Set a versioned tag to retain prior images for rollback.
LAYA_IMAGE=laya-platform:local
# Optional upstream secret; configure the URL/model in the admin settings page.
# Non-loopback upstreams with credentials must use HTTPS.
UPSTREAM_API_KEY=
