{
  "name": "laya-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Laya 独立前端，开发服务器或 Nginx 提供页面并同源代理 API",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test tests/unit/*.test.mjs tests/contract/*.test.mjs",
    "test:server": "node --test tests/integration/*.test.mjs",
    "test:nginx": "node tests/integration/nginx-check.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
